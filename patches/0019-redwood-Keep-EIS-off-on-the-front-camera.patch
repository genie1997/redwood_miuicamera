From 895ca9b30d53ba21cf7786e00babeb75eb87fad0 Mon Sep 17 00:00:00 2001
From: genie1997 <genie1997.dev@gmail.com>
Date: Tue, 3 Nov 2026 16:02:51 +0530
Subject: [PATCH] redwood: Keep EIS off on the front camera

Front EIS can stall after touch focus and freeze the recording. The
rear cameras keep it.
---
 .../android/camera/module/VideoModule.smali   | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/smali_classes2/com/android/camera/module/VideoModule.smali b/smali_classes2/com/android/camera/module/VideoModule.smali
index ed6a953f..135380d0 100644
--- a/smali_classes2/com/android/camera/module/VideoModule.smali
+++ b/smali_classes2/com/android/camera/module/VideoModule.smali
@@ -12584,6 +12584,30 @@
 
     .line 6
     :cond_0
+    iget v3, v0, LZ5/a;->a:I
+
+    invoke-static {}, LF3/f;->V()LF3/f;
+
+    move-result-object v4
+
+    invoke-virtual {v4, v3}, LF3/f;->d0(I)Z
+
+    move-result v3
+
+    if-eqz v3, :cond_redwood_rear
+
+    # redwood: front EIS stalls on touch focus, keep it off
+    iget-object p0, p0, Lcom/android/camera/module/VideoBase;->TAG:Ljava/lang/String;
+
+    const-string p1, "isEisOn: front camera, off"
+
+    new-array v0, v2, [Ljava/lang/Object;
+
+    invoke-static {p0, p1, v0}, Lcom/android/camera/log/Log;->d(Ljava/lang/String;Ljava/lang/String;[Ljava/lang/Object;)V
+
+    return v2
+
+    :cond_redwood_rear
     iget-object v3, p0, Lcom/android/camera/module/VideoBase;->mUserRecordSetting:Lcom/android/camera/module/video/z;
 
     iget p0, p0, Lcom/android/camera/module/BaseModule;->mModuleIndex:I
-- 
2.53.0

